{
  "manifest_version": 3,
  "name": "greytHR Time Remaining",
  "version": "0.12.0",
  "description": "Shows how much working time you have left today, based on your greytHR attendance swipes.",
  "permissions": ["storage", "alarms", "webRequest", "notifications", "tabs"],
  "host_permissions": ["https://*.greythr.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.greythr.com/*"],
      "js": ["autologin.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "greytHR Time Remaining",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
